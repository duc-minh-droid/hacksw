# All optional. With nothing set, the app runs in demo mode:
# keyless Esri satellite tiles, Open-Meteo weather and the model running in the browser.

# MapTiler key for MapTiler's satellite style (https://cloud.maptiler.com/account/keys/)
VITE_MAPTILER_KEY=

# URL of the FastAPI backend, e.g. http://localhost:8119
VITE_API_URL=
